# 运行环境
node_modules
node_modules/
.playwright-cli/
cordis.yml
*.log
.DS_Store
.env
.env.*
!.env.example
!.env.*.example
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# 本地临时输出（截图、手动验证产物等）
output/

# 本地代码分析资料、快照和缓存
.ua/

# 本机编辑器与 AI 助手配置（预览服务等）
/.claude/

# 用户数据（人物卡、聊天、剧本、素材、索引、设置、diff）
data/

# 按需重新取得的本地参考副本
/references/

# 本地调研、实验与验收记录，不入库（结论写进提交说明或功能文档）
/docs/research/
/docs/verification/
/docs/experiments/

# Local installation context (host and isolated home)
.dsh-tavern-local.json
# Old dependency folders the installer sets aside when isolating tavern-plugin
.legacy-node_modules-*/

# The 大肥鱼 demo card (examples/dafeiyu-card): too big to ship with the program.
/examples/dafeiyu-card/*.dshcard
/examples/dshcard-hello/*.dshcard
*.bak-*
